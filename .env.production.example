# Full-flow production profile: blank external settings intentionally block startup.
# Use scripts/configure.py init --profile production --env-file .env.production
PAPR_ENV=production
PROXY_SHARED_SECRET=
PROXY_API_TOKEN=
PROXY_PUBLIC_URL=
MAIN_SERVICE_URL=http://127.0.0.1:8001
PROXY_ALLOW_LEGACY_CONFIG=0
PROXY_DYNAMIC_REGISTRATION=0
SPEC_PARSER=claude
SPEC_ALLOW_RULE_FALLBACK=0
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
ENGINE_KIND=agent_v1
ENGINE_URL=
VP_AGENT_KEY=
VP_PROXY_MODE=supervised
ENGINE_POLL_S=0
MS_SUPPLIER_HOSTS={}
# Set absolute persistent paths on the deployment host.
PROXY_VAR_DIR=
MS_DATABASE=
